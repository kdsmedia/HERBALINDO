rules_version = '2';

// HERBALINDO security rules.
//
// The client may read catalogue data and its own records, but every value that can be
// redeemed (points, balance, referral bonus, order status, stock, withdrawal) is
// written exclusively by Cloud Functions, which run with the Admin SDK and bypass
// these rules. A tampered APK therefore cannot mint points or approve a withdrawal.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().role == 'ADMIN';
    }

    function isActiveUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().status == 'ACTIVE';
    }

    // Immutable value fields must never change through a client write.
    function valueFieldsUnchanged() {
      return request.resource.data.points == resource.data.points
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.role == resource.data.role
        && request.resource.data.referralId == resource.data.referralId
        && request.resource.data.status == resource.data.status
        && request.resource.data.verified == resource.data.verified;
    }

    // ------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      // Profiles are created by the registerProfile Cloud Function, which is the only
      // place a referralId (6 digits) is minted. Direct client creates are refused.
      allow create: if false;

      // Profile edits are limited to contact fields; value fields stay frozen.
      allow update: if isSelf(userId)
        && valueFieldsUnchanged()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow delete: if false;
    }

    // ---------------------------------------------------------- products
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // admin writes go through Cloud Functions
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ orders
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Orders are created and mutated by Cloud Functions only.
      allow write: if false;
    }

    match /order_items/{itemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ----------------------------------------------------- points ledger
    match /points_ledger/{entryId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Append-only, and only by the backend.
      allow write: if false;
    }

    // --------------------------------------------------------- referrals
    match /referrals/{referralId} {
      allow read: if isSignedIn()
        && (resource.data.inviterId == request.auth.uid
            || resource.data.invitedUserId == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    // -------------------------------------------------------- ad rewards
    match /ad_rewards/{rewardId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // -------------------------------------------------------- daily tasks
    match /daily_tasks/{taskId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ------------------------------------------------------- withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ----------------------------------------------------------- settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------- admin logs
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stock_movements/{movementId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}