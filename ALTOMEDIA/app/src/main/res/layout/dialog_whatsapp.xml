<?xml version="1.0" encoding="utf-8"?>
<!--
  Popup ajakan bergabung ke grup WhatsApp resmi. Ditampilkan setiap aplikasi
  dibuka, dengan banner, keterangan singkat, tombol bergabung, dan tombol
  penutup. Tautan berasal dari pengaturan yang dikelola admin.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_box"
        android:orientation="vertical">

        <!-- ===================== Banner ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_whatsapp_banner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_whatsapp"
                android:contentDescription="@string/wa_title"
                android:padding="10dp"
                android:src="@drawable/ic_whatsapp" />

            <TextView
                android:id="@+id/wa_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/wa_title"
                android:textColor="@color/text_on_brand"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wa_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/wa_subtitle"
                android:textColor="#EAFBF0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===================== Isi ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/wa_benefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/wa_benefits"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/wa_join"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_whatsapp_button"
                android:drawableStart="@drawable/ic_whatsapp"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="@string/wa_join"
                android:textAllCaps="false"
                android:textColor="@color/text_on_brand"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/wa_later"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/wa_later"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
