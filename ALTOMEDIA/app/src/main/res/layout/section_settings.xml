<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aturan yang tersimpan di sini langsung berlaku untuk seluruh perhitungan aplikasi."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Konversi Poin" android:textColor="@color/brand_green_dark" android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Poin per unit">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_points_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Rupiah per unit">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_rupiah_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Poin Harian" android:textColor="@color/brand_green_dark" android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Poin check-in harian">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_checkin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Poin per iklan berhadiah">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_ad_points" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Batas iklan per hari (1-100)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_ad_max" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Referral (1 Tingkat)" android:textColor="@color/brand_green_dark" android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Bonus referral (poin)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_ref_bonus" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Minimum nilai order (Rp)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_ref_min" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Withdrawal" android:textColor="@color/brand_green_dark" android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Minimum saldo Rp (maks 50000; BCA selalu 50000)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_min_wd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Maksimum pengajuan per hari">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_max_wd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <Switch
            android:id="@+id/set_require_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wajib menonton iklan harian sebelum withdrawal" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Pengiriman &amp; Pembelian" android:textColor="@color/brand_green_dark" android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Ongkir tetap (Rp)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_shipping" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Herbalindo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Gratis ongkir mulai (Rp, 0 = nonaktif)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/set_free_shipping" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <Switch
            android:id="@+id/set_purchase_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Poin diberikan untuk pembelian produk" />

        <Switch
            android:id="@+id/set_admob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tampilkan iklan banner AdMob" />

        <Button
            android:id="@+id/set_save"
            style="@style/Widget.Herbalindo.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save"
    app:icon="@drawable/ic_save" />

        <Button
            android:id="@+id/set_reset"
            style="@style/Widget.Herbalindo.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kembalikan Default"
    app:icon="@drawable/ic_restore" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingBottom="16dp"
            android:text="Setiap perubahan pengaturan dicatat pada audit log beserta nilai lamanya."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>