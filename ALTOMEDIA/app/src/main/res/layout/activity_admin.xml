<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel admin memakai menu samping (drawer) yang meluncur dari kiri. Sebelumnya
  tujuh bagian ditampilkan sebagai deretan TabLayout sehingga label panjang
  terpotong dan sulit dijangkau satu tangan. Drawer menampilkan seluruh bagian
  sekaligus dan menyisakan ruang layar penuh untuk isinya.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adm_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/adm_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_green_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/adm_menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/admin_menu_open"
                android:padding="10dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/adm_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_panel"
                    android:textColor="@color/text_on_brand"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/adm_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_green_pale"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/adm_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_accent_pill"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/logout"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/adm_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/adm_nav"
        android:layout_width="296dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_green_dark"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_panel"
                android:textColor="@color/text_on_brand"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adm_nav_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/brand_green_pale"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/adm_nav_dash"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_dash" />

                <TextView
                    android:id="@+id/adm_nav_orders"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_orders" />

                <TextView
                    android:id="@+id/adm_nav_products"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_products" />

                <TextView
                    android:id="@+id/adm_nav_members"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_members" />

                <TextView
                    android:id="@+id/adm_nav_withdrawals"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_withdrawals" />

                <TextView
                    android:id="@+id/adm_nav_settings"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_settings" />

                <TextView
                    android:id="@+id/adm_nav_logs"
                    style="@style/AdminNavItem"
                    android:text="@string/admin_section_logs" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/adm_nav_logout"
            style="@style/AdminNavItem"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="@string/logout"
            android:textColor="@color/danger" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
