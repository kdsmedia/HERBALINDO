<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!--
      Header tahan sempit: nama pengguna dipotong dengan elipsis (satu baris)
      agar tidak pernah mendorong tombol keranjang keluar layar, dan tombol
      keranjang memiliki ukuran minimum yang tetap.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_green_dark"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_green"
            android:contentDescription="@string/app_name"
            android:padding="7dp"
            android:src="@drawable/ic_product_placeholder"
            app:tint="@color/brand_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hdr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_on_brand"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/brand_green_pale"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hdr_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_accent_pill"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Keranjang 0"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      Wadah banner AdMob. AdView sengaja tidak dideklarasikan di XML: SDK iklan
      mewajibkan atribut ads:adUnitId pada setiap AdView di XML dan menolak
      atribut itu ditimpa dari kode, sehingga unit uji/produksi tidak dapat
      dipilih saat runtime. AdView dibuat dari kode oleh AdsManager.
    -->
    <FrameLayout
        android:id="@+id/member_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@color/surface" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/member_nav" />
</LinearLayout>